<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="betty"
        Arguments=""
        InstallLocation="C:\Program Files\Blueberry Team\Betty">
    </Installer>
    <PackageInformation
        PackageName="Betty"
        PackageDisplayName="Betty"
        PublisherName="CN=Blueberry Team"
        PublisherDisplayName="Blueberry Team"
        Version="0.1.0.0"
        PackageDescription="Betty - BerryTicket menu bar app">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.blueberryteam.betty"
                Description="Betty - BerryTicket menu bar app"
                DisplayName="Betty"
                ExecutableName="betty"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Betty</DisplayName>
            <PublisherDisplayName>Blueberry Team</PublisherDisplayName>
            <Description>Betty - BerryTicket menu bar app</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="betty.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
